    "%lld 项仍在原来的位置，可以在 Finder 中手动删除。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld items are still in their original location. You can delete them in Finder."
